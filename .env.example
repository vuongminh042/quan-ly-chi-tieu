# Sao chép thành .env. Không commit .env lên Git.
# MongoDB Community local:
MONGODB_URI=mongodb://127.0.0.1:27017/chitieu
# MongoDB Atlas: đặt tên database sau .net/ (ví dụ /chitieu), không đặt thành
# tên query parameter. URL-encode ký tự đặc biệt trong username/password.
# Ví dụ: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/chitieu?retryWrites=true&w=majority&appName=<app-name>

# Tạo khóa riêng bằng: openssl rand -hex 32
JWT_SECRET=thay-bang-chuoi-ngau-nhien-dai-it-nhat-32-ky-tu

# SMTP dùng để gửi email xác minh đăng ký đến hộp thư thật (local và production dùng cùng cấu hình SMTP).
# APP_URL là URL ứng dụng: local http://localhost:3000; production là domain HTTPS.
APP_URL=http://localhost:3000
# Tùy chọn: đặt URL public tunnel trỏ tới Express local (port 4000) để mở link email từ thiết bị bên ngoài.
EMAIL_VERIFICATION_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

# Cloudinary (cần thiết để tải ảnh đại diện; lấy trong Dashboard > API Keys)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Admin console allowlist (comma-separated registered account emails)
ADMIN_EMAILS=

# Chạy trên localhost HTTP: lax + false. Preview/HTTPS: none + true.
# Hai giá trị cookie được cấu hình tường minh, không suy ra từ NODE_ENV hay req.secure.
COOKIE_SAME_SITE=lax
COOKIE_SECURE=false

SERVER_PORT=4000
# Vite Preview chạy cổng 3000; production container nhận PORT=3000.
